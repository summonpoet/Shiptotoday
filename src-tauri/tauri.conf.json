{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DingDing Zones",
  "version": "0.1.0",
  "identifier": "com.xvc.dingdingzones",
  "build": {
    "beforeDevCommand": "npm run build:web",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DingDing Zones",
        "width": 420,
        "height": 780,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "backgroundColor": "#eef1f6"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "A focus timer that tracks effort and output.",
    "longDescription": "DingDing Zones is a compact focus timer, daily planner, and effort dashboard."
  }
}
